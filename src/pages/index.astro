---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.jpg";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A bespectacled kangaroo in a graduation cap and bandaged ear, standing beside a stack of books at the roadside, with a car passing on the highway behind it"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    You'll work through the research literature on kangaroo–vehicle collisions
    week by week — ecology and circadian activity, the national collision
    dataset, hotspot mapping, impact biomechanics, human factors, in-vehicle
    detection technology, and road engineering — before turning to law, cost,
    and post-collision response. Two pieces of work anchor the semester: a
    literature review and hotspot analysis in week 6, and an original
    safety-intervention proposal in week 12. Both ask you to build an argument
    a reader who wasn't in the room can follow and check against the evidence.
  </p>

  <h2>Who it is for</h2>
  <p>
    This is a postgraduate research-methods unit for students comfortable
    reading primary literature across ecology, engineering, and policy, and
    willing to argue from a dataset rather than a hunch. No prior wildlife
    biology or road engineering background is assumed — what matters is being
    ready to read widely and defend a claim in front of the group.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  /* The source photo has the kangaroo's face and cap near the top of a
     square frame; the theme's hero banner is very wide and short, so the
     default center-crop hides the face. Bias the crop upward instead. */
  :global(.at-hero .at-hero-image) {
    object-position: 50% 18%;
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
